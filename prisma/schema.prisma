generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  url      = env("DATABASE_URL")
}

datasource db {
  provider = "mysql"
}

model user {
  idMejista    Int               @id @default(autoincrement())
  nomeMembro   String
  email        String?
  senha        String?
  nivel        String
  role         Role
  cargo        String?
  numeroMembro String
  contacto     Int
  promessado   Promessado
  centroId     Int?
  actividades  actividade[]
  arquivos     arquivo[]
  livros       livros[]
  centro       centrosparoquias? @relation(fields: [centroId], references: [idCentrosParoquias])

  @@index([centroId], map: "user_centroId_fkey")
}

model paroquias {
  idParoquia       Int                @id @default(autoincrement())
  nomeParoquia     String
  quota            Int
  centrosparoquias centrosparoquias[]
}

model actividade {
  idActividades  Int           @id @default(autoincrement())
  nomeActividade String
  localizacao    String
  dataActiv      DateTime
  descricao      String
  userId         Int
  categoria      TipoCategoria
  estado         TipoEstado
  statusUpload   TipoStatus
  user           user          @relation(fields: [userId], references: [idMejista])
  arquivos       arquivo[]

  @@index([userId], map: "actividade_userId_fkey")
}

model arquivo {
  idArquivo    Int         @id @default(autoincrement())
  filename     String
  urlfile      String
  dataFile     DateTime
  local        localArqu
  tipoArqui    TipoArqui
  userId       Int?
  actividadeId Int?
  actividade   actividade? @relation(fields: [actividadeId], references: [idActividades], onDelete: Cascade)
  user         user?       @relation(fields: [userId], references: [idMejista], onDelete: Cascade)

  @@index([actividadeId], map: "arquivo_actividadeId_fkey")
  @@index([userId], map: "arquivo_userId_fkey")
}

model livros {
  idLivro      Int      @id @default(autoincrement())
  titulo       String
  url          String
  dataCadastro DateTime
  autor        String
  userId       Int
  user         user     @relation(fields: [userId], references: [idMejista], onDelete: Cascade)

  @@index([userId], map: "livros_userId_fkey")
}

model centrosparoquias {
  idCentrosParoquias Int                   @id @default(autoincrement())
  nomeCentro         String
  paroquiaId         Int
  tipo               centrosparoquias_tipo @default(Normal)
  paroquias          paroquias             @relation(fields: [paroquiaId], references: [idParoquia], onDelete: Cascade, map: "centrosParoquias_paroquiaId_fkey")
  membros            user[]

  @@index([paroquiaId], map: "centrosParoquias_paroquiaId_fkey")
}

enum Promessado {
  Nao
  Sim
}

enum Role {
  Admin
  User
}

enum localArqu {
  PERFIL
  MESSAGE
  ACTIVIDADE
}

enum TipoArqui {
  USER
  ACTIVIDADE
}

enum TipoStatus {
  PROCESSANDO
  CONCLUIDO
  ERRO
}

enum TipoEstado {
  Aberta
  Encerrada
}

enum TipoCategoria {
  Espiritualidade
  Missao
  Acampamento
  Formacao
}

enum centrosparoquias_tipo {
  Sede
  Normal
}
